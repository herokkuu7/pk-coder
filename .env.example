# Server configuration
PORT=10000
HOST=0.0.0.0

# Solver timeouts and limits (optimized for 512MB RAM free Render instances)
DEFAULT_TIMEOUT_MS=45000
MAX_CONCURRENT_SOLVES=1
MAX_QUEUE_SIZE=10
MAX_SOLVES_BEFORE_RECYCLE=50
MAX_RSS_MB=380

# Headless mode (true in production/Render, false for local visual debugging)
HEADLESS=true

# Node runtime options (Render sets this in Dockerfile, optionally set locally)
# NODE_OPTIONS=--max-old-space-size=192 --expose-gc

# Optional Residential / Datacenter Proxy Configuration
# Format 1: full URL
# PROXY_URL=http://username:password@proxy.example.com:8080
# Format 2: discrete credentials
# PROXY_SERVER=http://proxy.example.com:8080
# PROXY_USERNAME=username
# PROXY_PASSWORD=password
